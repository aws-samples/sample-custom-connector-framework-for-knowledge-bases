# Local examples only. CDK injects deployed values; production secrets stay in Secrets Manager.

# Required by deployed backend handlers: KMS key used for connector and job configuration.
CONFIGURATION_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000
# Required by deployed backend handlers: DynamoDB tables.
CUSTOM_CONNECTORS_TABLE_NAME=ccf-connectors
CUSTOM_CONNECTOR_JOBS_TABLE_NAME=ccf-jobs
CUSTOM_CONNECTOR_DOCUMENTS_TABLE_NAME=ccf-documents
# Required by orchestration and runtime wiring.
AWS_REGION=us-east-1
AWS_PARTITION=aws
FRAMEWORK_ACCOUNT_ID=123456789012
AWS_BATCH_JOB_QUEUE=ccf-job-queue
CUSTOM_CONNECTOR_API_ENDPOINT=https://example.execute-api.us-east-1.amazonaws.com/prod/
INGESTION_BUCKET_NAME=ccf-ingestion-example
DESTINATION_MODE=BEDROCK
FRAMEWORK_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/CcfFrameworkExecutionRole
SCHEDULER_TARGET_ARN=arn:aws:lambda:us-east-1:123456789012:function:ccf-scheduled-start
SCHEDULER_ROLE_ARN=arn:aws:iam::123456789012:role/CcfSchedulerTargetRole
SCHEDULER_GROUP_NAME=ccf
SCHEDULER_DLQ_ARN=arn:aws:sqs:us-east-1:123456789012:ccf-scheduler-dlq
# Required by the API handler: permission boundary attached to each per-connector runtime role.
RUNTIME_ROLE_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/CcfConnectorRuntimeBoundary
# Required by the API handler: JSON list of {method, path} routes a runtime role may call.
CONNECTOR_RUNTIME_ROUTES=[{"method":"GET","path":"/api/v1/custom-connectors/{connector_id}"}]
# Required by the API handler: comma-separated client account IDs admitted to register connectors.
ALLOWED_CLIENT_ACCOUNT_IDS=210987654321
# Optional: API path prefix (default /api/v1) and the service principal reported in CcfServiceReference (default ccf.amazonaws.com).
API_PREFIX=/api/v1
CCF_SERVICE_PRINCIPAL=ccf.amazonaws.com
# Required only for a BEDROCK deployment.
BEDROCK_KNOWLEDGE_BASE_ID=ABCDEFGHIJ
BEDROCK_DATA_SOURCE_ID=ABCDEFGHIJ

# Required inside a framework-started connector container.
CUSTOM_CONNECTOR_FRAMEWORK_API_ENDPOINT=https://example.execute-api.us-east-1.amazonaws.com/prod/
CUSTOM_CONNECTOR_FRAMEWORK_CUSTOM_CONNECTOR_ID=cc-example
CUSTOM_CONNECTOR_FRAMEWORK_CUSTOM_CONNECTOR_ARN_PREFIX=arn:aws:ccf:us-east-1:123456789012
CUSTOM_CONNECTOR_JOB_ID=ccj-example
