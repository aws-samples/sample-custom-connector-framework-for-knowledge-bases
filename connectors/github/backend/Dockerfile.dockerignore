# The GitHub connector image builds from the repository root, because it installs the
# CCF toolkit and API models from framework/. Send only those and the connector backend.
**
!framework/
framework/*
!framework/api/
framework/api/*
!framework/api/packages/
framework/api/packages/*
!framework/api/packages/ccf-api-models/
!framework/api/packages/ccf-api-models/**
!framework/toolkit/
!framework/toolkit/**
!connectors/
connectors/*
!connectors/github/
connectors/github/*
!connectors/github/backend/
!connectors/github/backend/**

# Never send version-control metadata or local environment state.
**/.git
**/.git/**
**/.hg
**/.hg/**
**/.svn
**/.svn/**
**/.env
**/.env.*

# Never send credential stores or likely credential files.
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.netrc
**/.npmrc
**/.pypirc
**/credentials
**/credentials.*
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Never send caches, dependencies, or generated build outputs.
**/.mypy_cache
**/.mypy_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/.pytest_cache
**/.pytest_cache/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.venv
**/.venv/**
**/node_modules
**/node_modules/**
**/cdk.out
**/cdk.out/**
**/build
**/build/**
**/dist
**/dist/**
**/target
**/target/**
**/coverage
**/coverage/**
**/.coverage
**/htmlcov
**/htmlcov/**
**/*.egg-info
**/*.egg-info/**
