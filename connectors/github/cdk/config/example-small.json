{
  "sources": [{ "type": "ORG", "name": "aws-samples" }],
  "owners": {
    "aws-samples": { "scheduleWeekDay": "SUN", "scheduleHourUtc": 2 }
  },
  "connectorCompute": { "cpu": 1, "memoryMib": 4096, "timeoutHours": 2 },
  "connectorConfiguration": {
    "max_repositories": 5,
    "max_repository_age_days": 730,
    "excluded_repository_patterns": [
      "aws-sdk*",
      "*-sdk",
      "*-sdk-*",
      "sdk-*",
      "aws-cdk-go",
      "api-models-aws",
      "aws-tools-for-powershell"
    ],
    "excluded_path_patterns": [
      ".git/",
      "node_modules/",
      "bower_components/",
      "jspm_packages/",
      ".venv/",
      "venv/",
      "env/",
      "__pycache__/",
      "*.py[cod]",
      "*.egg-info/",
      ".eggs/",
      ".pytest_cache/",
      ".mypy_cache/",
      ".ruff_cache/",
      ".tox/",
      ".nox/",
      ".ipynb_checkpoints/",
      "dist/",
      "build/",
      "target/",
      "obj/",
      ".gradle/",
      ".next/",
      ".nuxt/",
      ".cache/",
      "coverage/",
      ".coverage",
      "htmlcov/",
      "cdk.out/",
      ".aws-sam/",
      ".serverless/",
      ".terraform/",
      "*.tfstate",
      "*.tfstate.*",
      "*.o",
      "*.a",
      "*.so",
      "*.dylib",
      "*.dll",
      "*.exe",
      "*.class",
      "*.jar",
      "*.wasm",
      ".idea/",
      ".vscode/",
      "*.swp",
      ".DS_Store",
      "Thumbs.db",
      "*.log",
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ],
    "max_file_bytes": 104857600,
    "full_read_interval_days": 28,
    "github": {
      "request_interval_seconds": 2,
      "request_timeout_seconds": 30,
      "retry_attempts": 5,
      "retry_backoff_seconds": 2,
      "max_rate_limit_wait_seconds": 3900
    }
  },
  "command": ["github_connector:GitHubConnectorImplementation"],
  "maxImageAgeDays": 90,
  "logRetentionDays": 7,
  "logDelivery": false,
  "removalPolicy": "DESTROY",
  "destination": { "id": "dst-7c41e9a2b5d0" },
  "imageRepositoryName": "ccf-connectors/github",
  "sourceAccessServices": [],
  "framework": {
    "endpoint": "https://abcdef1234.execute-api.us-east-1.amazonaws.com/ccf",
    "serviceAccount": "444455556666",
    "batchExecutionRoleArn": "arn:aws:iam::444455556666:role/ccf/CcfBatchExecutionRole",
    "destinationWorkflowArn": "arn:aws:states:us-east-1:444455556666:stateMachine:CcfDestinationWorkflow"
  },
  "costCenter": "unassigned",
  "team": "unassigned"
}
