# Send only the generated API models, toolkit, and sample packages.
**
!api/
api/*
!api/packages/
api/packages/*
!api/packages/ccf-api-models/
!api/packages/ccf-api-models/**
!toolkit/
!toolkit/**
!samples/
!samples/**

# Never send version-control metadata or local environment state.
**/.git
**/.git/**
**/.hg
**/.hg/**
**/.svn
**/.svn/**
**/.env
**/.env.*

# Never send credential stores or likely credential files.
**/.aws
**/.aws/**
**/.ssh
**/.ssh/**
**/.netrc
**/.npmrc
**/.pypirc
**/credentials
**/credentials.*
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Never send caches, dependencies, or generated build outputs.
**/.mypy_cache
**/.mypy_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/.pytest_cache
**/.pytest_cache/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/.venv
**/.venv/**
**/node_modules
**/node_modules/**
**/cdk.out
**/cdk.out/**
**/build
**/build/**
**/dist
**/dist/**
**/target
**/target/**
**/coverage
**/coverage/**
**/.coverage
**/htmlcov
**/htmlcov/**
**/*.egg-info
**/*.egg-info/**
