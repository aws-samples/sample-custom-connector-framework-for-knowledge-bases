# The settings the framework reads from its environment, with example values for running a handler
# or a job locally. The CDK apps set every one in each deployed function and job definition; none
# has a default, and a missing or malformed value fails at start, naming the setting. No setting
# is a secret. Copy to .env, which git ignores. Every variable below is required by the component
# whose section it is in.

# --- Framework Lambda handlers (framework/backend/src/common/settings.py) ---
# A double underscore separates a settings group from its member: TABLES__DESTINATIONS is
# `tables.destinations`. ccf_api_models/contracts/settings.json lists each handler's names.

# Every handler: the Region the service runs in.
AWS_REGION=us-east-1
# Every handler: the partition, for the ARNs the handler builds.
AWS_PARTITION=aws
# Every handler: the service account, the account that hosts the framework.
SERVICE_ACCOUNT_ID=444455556666
# Every handler: the service key that encrypts connector configurations, job configurations, and checkpoints.
RESOURCE_DATA_KEY_ARN=arn:aws:kms:us-east-1:444455556666:key/1234abcd-12ab-34cd-56ef-1234567890ab
# Every handler: the framework's six tables.
TABLES__DESTINATIONS=CcfDestinations
TABLES__CONNECTORS=CcfCustomConnectors
TABLES__JOBS=CcfCustomConnectorJobs
TABLES__COLLECTIONS=CcfCollections
TABLES__DOCUMENTS=CcfDocuments
TABLES__IDEMPOTENCY=CcfIdempotency

# API handler: the domain suffix of the Region's AWS endpoints.
AWS_URL_SUFFIX=amazonaws.com
# API and scheduled-start handlers: how long a create's saved response answers a retry, in seconds.
IDEMPOTENCY__EXPIRY_SECONDS=86400
# API handler: the API's ID (10 lowercase letters and digits) and stage, for the runtime roles' execute-api ARNs.
RUNTIME_ROLES__REST_API_ID=abcdef1234
RUNTIME_ROLES__STAGE_NAME=ccf
# API handler: the permissions boundary of every runtime role it creates.
RUNTIME_ROLES__BOUNDARY_ARN=arn:aws:iam::444455556666:policy/CcfConnectorRuntimeBoundary
# API handler: JSON list of the routes a runtime role may call.
RUNTIME_ROLES__ROUTES=[{"method":"GET","path":"/api/v1/destinations/{destination_id}/custom-connectors/{connector_id}"}]
# API handler: each runtime role's path, name prefix, inline policy name, and maximum session in seconds.
RUNTIME_ROLES__ROLE_PATH=/ccf-runtime/
RUNTIME_ROLES__ROLE_NAME_PREFIX=CcfConnectorRuntime-
RUNTIME_ROLES__POLICY_NAME=CcfConnectorRuntimePolicy
RUNTIME_ROLES__MAX_SESSION_SECONDS=43200
# API handler: what each custom connector's schedule invokes, as which role, in which group, with which
# dead-letter queue, and how a failed delivery retries.
SCHEDULER__TARGET_ARN=arn:aws:lambda:us-east-1:444455556666:function:CcfScheduledStart
SCHEDULER__ROLE_ARN=arn:aws:iam::444455556666:role/CcfSchedulerTargetRole
SCHEDULER__GROUP_NAME=CcfSchedulerGroup
SCHEDULER__DEAD_LETTER_ARN=arn:aws:sqs:us-east-1:444455556666:CcfSchedulerTargetDlq
SCHEDULER__RETRY_ATTEMPTS=3
SCHEDULER__MAX_EVENT_AGE_SECONDS=3600
# API handler and ingestion consumer: the destination workflow, also the external ID every CcfDestinationRole
# trust policy requires, and the workflow that deletes a custom connector's files and records.
WORKFLOWS__DESTINATION=arn:aws:states:us-east-1:444455556666:stateMachine:CcfDestinationWorkflow
WORKFLOWS__CONNECTOR_DELETION=arn:aws:states:us-east-1:444455556666:stateMachine:CcfConnectorDeletionWorkflow
# API handler: comma-separated tenant accounts besides the service account; may be empty.
ALLOWED_TENANT_ACCOUNT_IDS=111122223333
# API and scheduled-start handlers: the state machine that runs each job, and how long the jobs table keeps a
# finished job's record and a started job's record, in seconds.
JOBS__JOB_EXECUTION_ARN=arn:aws:states:us-east-1:444455556666:stateMachine:CcfJobExecution
JOBS__RECORD_RETENTION_SECONDS=604800
JOBS__ACTIVE_RECORD_RETENTION_SECONDS=1209600
# API handler: what every custom connector's job definition is built from: its name prefix, the role ECS uses
# to pull images and write logs, the framework API endpoint each job calls, and the log router's image (with a
# version tag), log group, and stream prefix.
JOB_DEFINITIONS__NAME_PREFIX=CcfJob-
JOB_DEFINITIONS__EXECUTION_ROLE_ARN=arn:aws:iam::444455556666:role/ccf/CcfBatchExecutionRole
JOB_DEFINITIONS__API_ENDPOINT=https://abcdef1234.execute-api.us-east-1.amazonaws.com/ccf/
JOB_DEFINITIONS__LOG_ROUTER_IMAGE=public.ecr.aws/aws-observability/aws-for-fluent-bit:2.34.3.20261102
JOB_DEFINITIONS__LOG_ROUTER_LOG_GROUP=/aws/batch/job
JOB_DEFINITIONS__LOG_ROUTER_STREAM_PREFIX=ccf-log-router

# Ingestion consumer: where a request that can't succeed goes.
INGESTION_DEAD_LETTER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/444455556666/CcfIngestionDlq

# --- Custom connector job container (framework/toolkit launcher.py, RuntimeSettings) ---
# The job definition sets these on the `connector` container; AWS_REGION above is read too.

# The framework API endpoint the job calls.
CUSTOM_CONNECTOR_FRAMEWORK_API_ENDPOINT=https://abcdef1234.execute-api.us-east-1.amazonaws.com/ccf/
# The tenant whose custom connector runs: arn:<partition>:<service>:<region>:<account>.
CUSTOM_CONNECTOR_FRAMEWORK_TENANT_ARN_PREFIX=arn:aws:ccf:us-east-1:111122223333
# The destination, custom connector, and job the container runs.
CUSTOM_CONNECTOR_FRAMEWORK_DESTINATION_ID=dst-7c41e9a2b5d0
CUSTOM_CONNECTOR_FRAMEWORK_CUSTOM_CONNECTOR_ID=cc-3f9a1b2c4d5e
CUSTOM_CONNECTOR_FRAMEWORK_JOB_ID=ccj-0fdef5d64630

# --- Custom resource Lambda in a tenant stack (framework/cdk/lambdas/connector_ops/ccf.py) ---

# The framework API endpoint the destination and custom connector custom resources call.
FRAMEWORK_ENDPOINT=https://abcdef1234.execute-api.us-east-1.amazonaws.com/ccf/
# The service Region, where the framework API runs.
SERVICE_REGION=us-east-1
